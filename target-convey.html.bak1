<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>目标传达 · 肆意股份</title>
  <meta name="description" content="目标传达是肆意股份旗下地产营销策划事业群，提供品牌定位、营销全案、视频内容与流量传播等服务。" />
  <link rel="icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Noto+Serif+SC:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            seg: {
              green:    '#2D5A4E',
              'green-dark': '#1E3D35',
              'green-deeper': '#162D27',
              'green-light': '#3D7A6A',
              'green-pale': '#EBF2F0',
              gold:     '#C9A84C',
              'gold-light': '#E2C47A',
              charcoal: '#1A1A1A',
              muted:    '#6B7280',
              border:   '#E5EAE8',
            }
          },
          fontFamily: {
            display: ['"Playfair Display"', 'Georgia', 'serif'],
            serif:   ['"Noto Serif SC"', '"Source Han Serif SC"', 'serif'],
            sans:    ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    /* ===== Base ===== */
    html { scroll-behavior: smooth; }
    body { font-family: 'Noto Serif SC', serif; color: #1A1A1A; background: #fff; }

    /* ===== Scroll animations ===== */
    .fade-up  { opacity: 0; transform: translateY(36px); transition: opacity 0.85s cubic-bezier(.22,1,.36,1), transform 0.85s cubic-bezier(.22,1,.36,1); }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
    .fade-in  { opacity: 0; transition: opacity 0.9s ease; }
    .fade-in.visible { opacity: 1; }

    /* ===== Navigation ===== */
    #navbar { transition: background 0.4s ease, box-shadow 0.4s ease; }
    .nav-scrolled { background: rgba(22,45,39,0.97) !important; backdrop-filter: blur(16px); box-shadow: 0 1px 0 rgba(255,255,255,0.06); }
    .nav-link { position: relative; }
    .nav-link::after { content:''; position:absolute; bottom:-2px; left:0; width:0; height:1px; background:#C9A84C; transition: width 0.3s ease; }
    .nav-link:hover::after { width:100%; }

    /* ===== Hero ===== */
    .hero-bg {
      background: linear-gradient(160deg, #0E2420 0%, #1E3D35 35%, #2D5A4E 65%, #1A2E28 100%);
    }
    .hero-noise::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
      pointer-events: none;
    }
    .hero-watermark {
      font-family: 'Playfair Display', serif;
      font-size: clamp(80px, 18vw, 220px);
      font-weight: 700;
      color: rgba(255,255,255,0.03);
      line-height: 1;
      user-select: none;
      pointer-events: none;
    }

    /* ===== Section label ===== */
    .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #2D5A4E;
    }
    .section-eyebrow::before, .section-eyebrow::after {
      content: '';
      display: block;
      width: 24px;
      height: 1px;
      background: #2D5A4E;
    }

    /* ===== Stats ===== */
    .stat-divider { border-right: 1px solid #E5EAE8; }
    @media (max-width: 768px) { .stat-divider { border-right: none; border-bottom: 1px solid #E5EAE8; } }

    /* ===== Flywheel ===== */
    .flywheel-ring {
      animation: spin-slow 20s linear infinite;
    }
    @keyframes spin-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .flywheel-pulse {
      animation: pulse-glow 3s ease-in-out infinite;
    }
    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(45,90,78,0.25); }
      50%       { box-shadow: 0 0 0 18px rgba(45,90,78,0); }
    }

    /* ===== Service cards ===== */
    .service-card {
      position: relative;
      overflow: hidden;
      transition: transform 0.35s ease, box-shadow 0.35s ease;
    }
    .service-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #2D5A4E 0%, #1E3D35 100%);
      opacity: 0;
      transition: opacity 0.35s ease;
    }
    .service-card:hover { transform: translateY(-6px); box-shadow: 0 24px 48px rgba(45,90,78,0.12); }
    .service-card:hover::before { opacity: 1; }
    .service-card:hover .sc-icon { background: rgba(255,255,255,0.12); }
    .service-card:hover .sc-title { color: #fff; }
    .service-card:hover .sc-desc  { color: rgba(255,255,255,0.7); }
    .service-card:hover .sc-num   { color: rgba(255,255,255,0.12); }
    .service-card > * { position: relative; z-index: 1; }

    /* ===== Case cards ===== */
    .case-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .case-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
    .case-tag { font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; }

    /* ===== Tab buttons ===== */
    .tab-btn { font-family: 'Inter', sans-serif; font-size: 12px; letter-spacing: 0.08em; transition: all 0.25s ease; }
    .tab-btn.active { background: #2D5A4E; color: #fff; border-color: #2D5A4E; }
    .tab-btn:not(.active):hover { border-color: #2D5A4E; color: #2D5A4E; }

    /* ===== Partners ===== */
    .partner-tag {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.05em;
      transition: all 0.25s ease;
    }
    .partner-tag:hover { background: #2D5A4E; color: #fff; border-color: #2D5A4E; }

    /* ===== Marquee ===== */
    .marquee-track { display: flex; gap: 0; animation: marquee 30s linear infinite; }
    .marquee-track:hover { animation-play-state: paused; }
    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* ===== Mobile menu ===== */
    .mobile-menu { transform: translateX(100%); transition: transform 0.35s cubic-bezier(.22,1,.36,1); }
    .mobile-menu.open { transform: translateX(0); }

    /* ===== Counter ===== */
    .counter { font-variant-numeric: tabular-nums; }

    /* ===== Scroll indicator ===== */
    .scroll-indicator { animation: bounce-soft 2s ease-in-out infinite; }
    @keyframes bounce-soft { 0%,100% { transform: translateY(0) translateX(-50%); } 50% { transform: translateY(8px) translateX(-50%); } }
  </style>
</head>
<body class="bg-white">

  <!-- ==================== NAVIGATION ==================== -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50" style="background: rgba(14,36,32,0.55); backdrop-filter: blur(8px);">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex items-center justify-between h-16 lg:h-20">
        <!-- Logo -->
        <a href="https://cn.segxm.com" class="flex items-center gap-3 group">
          <img src="/images/siyi-logo-white.webp" alt="SEG" class="h-7 w-auto opacity-90 group-hover:opacity-100 transition-opacity">
          <div class="hidden sm:block">
            <p class="text-white font-serif text-sm font-semibold leading-none tracking-wide">肆意股份</p>
            <p class="text-white/40 text-[9px] tracking-[0.2em] mt-0.5 font-sans">SUPER ENERGY GROUP</p>
          </div>
        </a>
        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-8">
          <a href="#about"    class="nav-link text-white/75 hover:text-white text-sm font-sans transition-colors">关于我们</a>
          <a href="#services" class="nav-link text-white/75 hover:text-white text-sm font-sans transition-colors">业务板块</a>
          <a href="#cases"    class="nav-link text-white/75 hover:text-white text-sm font-sans transition-colors">案例展示</a>
          <a href="#partners" class="nav-link text-white/75 hover:text-white text-sm font-sans transition-colors">合作伙伴</a>
          <a href="#contact"  class="nav-link text-white/75 hover:text-white text-sm font-sans transition-colors">联系我们</a>
        </div>
        <!-- CTA -->
        <a href="#contact" class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 bg-seg-gold text-seg-charcoal text-xs font-sans font-semibold tracking-wider rounded-sm hover:bg-seg-gold-light transition-colors">
          合作咨询
        </a>
        <!-- Mobile btn -->
        <button id="menuBtn" class="lg:hidden text-white p-2" onclick="document.getElementById('mobileMenu').classList.toggle('open')">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <!-- Mobile Menu -->
    <div id="mobileMenu" class="mobile-menu fixed top-0 right-0 w-72 h-full bg-seg-green-deeper z-50 p-8 lg:hidden">
      <button class="absolute top-5 right-5 text-white/50 hover:text-white" onclick="document.getElementById('mobileMenu').classList.remove('open')">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <div class="flex flex-col gap-7 mt-14">
        <a href="#about"    class="text-white/80 font-serif text-base" onclick="document.getElementById('mobileMenu').classList.remove('open')">关于我们</a>
        <a href="#services" class="text-white/80 font-serif text-base" onclick="document.getElementById('mobileMenu').classList.remove('open')">业务板块</a>
        <a href="#cases"    class="text-white/80 font-serif text-base" onclick="document.getElementById('mobileMenu').classList.remove('open')">案例展示</a>
        <a href="#partners" class="text-white/80 font-serif text-base" onclick="document.getElementById('mobileMenu').classList.remove('open')">合作伙伴</a>
        <a href="#contact"  class="text-white/80 font-serif text-base" onclick="document.getElementById('mobileMenu').classList.remove('open')">联系我们</a>
        <a href="#contact"  class="mt-2 inline-flex items-center justify-center px-5 py-3 bg-seg-gold text-seg-charcoal text-sm font-sans font-semibold rounded-sm">合作咨询</a>
      </div>
    </div>
  </nav>

  <!-- ==================== HERO ==================== -->
  <section class="relative min-h-screen flex flex-col justify-center overflow-hidden" style="background:#000;">
    <!-- Video background -->
    <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover" style="z-index:0;">
      <source src="/videos/hero-bg.mp4" type="video/mp4">
    </video>
    <!-- Watermark text -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden" style="z-index:2;">
      <span class="hero-watermark">GREAT<br>DECISION</span>
    </div>
    <!-- Decorative lines -->
    <div class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-white/10 to-transparent ml-16 hidden lg:block"></div>
    <div class="absolute right-0 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-white/10 to-transparent mr-16 hidden lg:block"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 pt-28 pb-24 lg:pt-36 lg:pb-32">
      <div class="max-w-3xl">
        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-8 fade-in">
          <span class="w-8 h-px bg-seg-gold"></span>
          <span class="text-seg-gold font-sans text-xs tracking-[0.3em] uppercase">广告事业群 · Target Convey</span>
        </div>
        <!-- Main heading -->
        <h1 class="font-display text-white leading-[1.05] mb-6 fade-up" style="font-size: clamp(2.8rem, 7vw, 5.5rem);">
          目标传达
        </h1>
        <p class="font-display italic text-white/40 text-xl lg:text-2xl mb-8 fade-up" style="transition-delay:0.1s">
          Great Decision · Est. 2004
        </p>
        <p class="font-serif text-white/65 text-base lg:text-lg leading-relaxed mb-10 max-w-xl fade-up" style="transition-delay:0.2s">
          深耕闽粤，辐射全国<br>
          福建千万级豪宅广告服务占有率<span class="text-seg-gold font-semibold">第一</span>
        </p>
        <div class="flex flex-wrap gap-4 fade-up" style="transition-delay:0.3s">
          <a href="#about" class="inline-flex items-center gap-2 px-7 py-3 bg-seg-gold text-seg-charcoal text-sm font-sans font-semibold rounded-sm hover:bg-seg-gold-light transition-colors">
            了解更多
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#cases" class="inline-flex items-center gap-2 px-7 py-3 border border-white/25 text-white text-sm font-sans rounded-sm hover:bg-white/8 transition-colors">
            案例展示
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator absolute bottom-8 left-1/2 flex flex-col items-center gap-2">
      <span class="text-white/30 font-sans text-[9px] tracking-[0.3em]">SCROLL</span>
      <div class="w-px h-10 bg-gradient-to-b from-white/30 to-transparent"></div>
    </div>
  </section>

  <!-- ==================== STATS ==================== -->
  <section class="py-16 lg:py-20 bg-white border-b border-seg-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 lg:grid-cols-4">
        <div class="fade-up text-center py-8 px-4 stat-divider">
          <p class="font-sans text-seg-muted text-xs tracking-[0.15em] uppercase mb-3">员工人数</p>
          <p class="font-display text-5xl lg:text-6xl font-bold text-seg-green leading-none"><span class="counter" data-target="200">0</span><span class="text-seg-gold">+</span></p>
        </div>
        <div class="fade-up text-center py-8 px-4 stat-divider" style="transition-delay:0.1s">
          <p class="font-sans text-seg-muted text-xs tracking-[0.15em] uppercase mb-3">影响城市</p>
          <p class="font-display text-5xl lg:text-6xl font-bold text-seg-green leading-none"><span class="counter" data-target="30">0</span><span class="text-seg-gold">+</span></p>
        </div>
        <div class="fade-up text-center py-8 px-4 stat-divider" style="transition-delay:0.2s">
          <p class="font-sans text-seg-muted text-xs tracking-[0.15em] uppercase mb-3">服务项目</p>
          <p class="font-display text-5xl lg:text-6xl font-bold text-seg-green leading-none"><span class="counter" data-target="600">0</span><span class="text-seg-gold">+</span></p>
        </div>
        <div class="fade-up text-center py-8 px-4" style="transition-delay:0.3s">
          <p class="font-sans text-seg-muted text-xs tracking-[0.15em] uppercase mb-3">豪宅市场占有率</p>
          <p class="font-display text-4xl lg:text-5xl font-bold text-seg-gold leading-none">第一</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section id="about" class="py-24 lg:py-32 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">
        <!-- Left: Text -->
        <div>
          <div class="fade-up mb-8">
            <span class="section-eyebrow">About Us</span>
          </div>
          <h2 class="font-display text-3xl lg:text-4xl font-bold text-seg-charcoal leading-tight mb-6 fade-up" style="transition-delay:0.05s">
            深耕闽粤<br>
            <span class="text-seg-green">辐射全国</span>
          </h2>
          <p class="font-sans text-seg-muted text-sm mb-8 fade-up" style="transition-delay:0.1s">
            福建千万级豪宅广告服务占有率第一 · 佛山千万级豪宅市场占有率第一
          </p>
          <div class="space-y-5 fade-up" style="transition-delay:0.15s">
            <p class="font-serif text-seg-charcoal leading-relaxed text-base">
              <strong class="font-semibold">肆意股份·厦门目标传达策划有限公司</strong>，成立于2004年，是国内最具资历的开发商品牌、房地产项目及城市更新策划营销顾问机构之一。
            </p>
            <p class="font-serif text-seg-charcoal/80 leading-relaxed text-base">
              二十多年来，与各个时代的头部房企并肩作战，提供从前期定位、策略顾问到营销全案推广的深度服务，用实战业绩说话。
            </p>
          </div>
          <!-- Key metrics -->
          <div class="grid grid-cols-2 gap-4 mt-10 fade-up" style="transition-delay:0.2s">
            <div class="p-5 bg-seg-green-pale rounded-sm border-l-2 border-seg-green">
              <p class="font-sans text-seg-muted text-xs mb-1">2022—2024</p>
              <p class="font-serif text-seg-charcoal font-semibold text-sm">千万级豪宅服务 <span class="text-seg-green font-bold">15+</span> 个</p>
            </div>
            <div class="p-5 bg-seg-green-pale rounded-sm border-l-2 border-seg-green">
              <p class="font-sans text-seg-muted text-xs mb-1">覆盖范围</p>
              <p class="font-serif text-seg-charcoal font-semibold text-sm">全国 <span class="text-seg-green font-bold">23</span> 城</p>
            </div>
          </div>
        </div>

        <!-- Right: Flywheel -->
        <div class="fade-up" style="transition-delay:0.1s">
          <div class="relative w-full max-w-sm mx-auto" style="aspect-ratio:1">
            <!-- Outer dashed ring -->
            <svg class="absolute inset-0 w-full h-full flywheel-ring" viewBox="0 0 320 320" fill="none">
              <circle cx="160" cy="160" r="148" stroke="#2D5A4E" stroke-width="1" stroke-dasharray="6 8" opacity="0.25"/>
              <circle cx="160" cy="160" r="110" stroke="#C9A84C" stroke-width="0.5" stroke-dasharray="4 6" opacity="0.2"/>
            </svg>
            <!-- Center -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-28 h-28 bg-seg-green rounded-full flex flex-col items-center justify-center flywheel-pulse z-10 shadow-lg">
              <span class="text-white font-serif font-semibold text-sm">不动产</span>
              <span class="text-white/50 font-sans text-[9px] tracking-wider mt-0.5">REAL ESTATE</span>
            </div>
            <!-- Top: 资本 -->
            <div class="absolute top-3 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
              <div class="w-14 h-14 bg-seg-green-dark rounded-full flex items-center justify-center shadow-md">
                <span class="text-white font-serif text-xs font-medium">资本</span>
              </div>
              <div class="text-center">
                <p class="text-seg-muted font-sans text-[10px]">融资 · 赋能</p>
              </div>
            </div>
            <!-- Left: 流量 -->
            <div class="absolute left-0 top-1/2 -translate-y-1/2 flex items-center gap-2">
              <div class="w-14 h-14 bg-seg-green-dark rounded-full flex items-center justify-center shadow-md">
                <span class="text-white font-serif text-xs font-medium">流量</span>
              </div>
              <div>
                <p class="text-seg-muted font-sans text-[10px] leading-relaxed">高质量内容<br>强IP矩阵<br>万人社群</p>
              </div>
            </div>
            <!-- Right: 再设计 -->
            <div class="absolute right-0 top-1/2 -translate-y-1/2 flex items-center gap-2 flex-row-reverse">
              <div class="w-14 h-14 bg-seg-green-dark rounded-full flex items-center justify-center shadow-md">
                <span class="text-white font-serif text-xs font-medium">再设计</span>
              </div>
              <div class="text-right">
                <p class="text-seg-muted font-sans text-[10px] leading-relaxed">定位 → 设计<br>造场 → 营销</p>
              </div>
            </div>
            <!-- Connecting lines -->
            <svg class="absolute inset-0 w-full h-full" style="pointer-events:none;" viewBox="0 0 320 320">
              <line x1="160" y1="55" x2="160" y2="100" stroke="#2D5A4E" stroke-width="1" stroke-dasharray="4 4" opacity="0.4"/>
              <line x1="55"  y1="160" x2="100" y2="160" stroke="#2D5A4E" stroke-width="1" stroke-dasharray="4 4" opacity="0.4"/>
              <line x1="220" y1="160" x2="265" y2="160" stroke="#2D5A4E" stroke-width="1" stroke-dasharray="4 4" opacity="0.4"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SERVICES ==================== -->
  <section id="services" class="py-24 lg:py-32 bg-seg-green-pale">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16 fade-up">
        <span class="section-eyebrow">Services</span>
        <h2 class="font-display text-3xl lg:text-4xl font-bold text-seg-charcoal mt-5">三大业务板块</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <!-- 广告全案 -->
        <div class="service-card bg-white rounded-sm p-8 cursor-default fade-up">
          <span class="sc-num font-display text-7xl font-bold text-seg-green/8 leading-none block mb-4 transition-colors duration-300">01</span>
          <div class="sc-icon w-12 h-12 bg-seg-green-pale rounded-sm flex items-center justify-center mb-5 transition-colors duration-300">
